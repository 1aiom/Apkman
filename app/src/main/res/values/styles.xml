<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CalcBtnBase">
        <item name="android:layout_width">80dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- أزرار الأرقام: رمادي غامق -->
    <style name="CalcNumBtn" parent="CalcBtnBase">
        <item name="android:background">@drawable/btn_num_bg</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- زر الصفر (عريض) -->
    <style name="CalcZeroBtn" parent="CalcBtnBase">
        <item name="android:layout_width">172dp</item>
        <item name="android:layout_columnSpan">2</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:background">@drawable/btn_num_bg</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- أزرار العمليات: برتقالي -->
    <style name="CalcOpBtn" parent="CalcBtnBase">
        <item name="android:background">@drawable/btn_op_bg</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- أزرار الوظائف: رمادي فاتح -->
    <style name="CalcFuncBtn" parent="CalcBtnBase">
        <item name="android:background">@drawable/btn_func_bg</item>
        <item name="android:textColor">#000000</item>
    </style>

</resources>
